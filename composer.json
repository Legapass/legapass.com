{
  "name": "roots/bedrock",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with modern development tools, easier configuration, and an improved folder structure",
  "homepage": "https://roots.io/bedrock/",
  "authors": [
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "bedrock",
    "composer",
    "roots",
    "wordpress",
    "wp",
    "wp-config"
  ],
  "support": {
    "issues": "https://github.com/roots/bedrock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "composer",
      "url": "https://packagist.org/"
    },
    {
      "type": "composer",
      "url": "https://wp-languages.github.io",
      "only": [
        "koodimonni-language/*",
        "koodimonni-plugin-language/*",
        "koodimonni-theme-language/*"
      ]
    },
    {
      "type": "package",
      "package": {
        "name": "themeforest/veapp",
        "type": "wordpress-plugin",
        "version": "1.0.0",
        "dist": {
          "type": "zip",
          "url": "https://github.com/Legapass/ZipTheme/raw/main/themeforest-npL3X2Ms-veapp-mobile-startup-template-kit.zip"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "translatepress/business",
        "type": "wordpress-plugin",
        "version": "1.2.2",
        "dist": {
          "type": "zip",
          "url": "https://github.com/Legapass/ZipTheme/raw/main/translatepress-business-1.2.2.zip"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "axeptio/cookies",
        "type": "wordpress-plugin",
        "version": "1.0.0",
        "dist": {
          "type": "zip",
          "url": "https://github.com/Legapass/ZipTheme/raw/main/axeptio-cookies.zip"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.4",
    "composer/installers": "^1.12",
    "vlucas/phpdotenv": "^3.4.0",
    "oscarotero/env": "^1.2.0",
    "roots/wordpress": "7.0.2",
    "roots/wp-config": "1.0.0",
    "roots/wp-password-bcrypt": "1.2.0",
    "humanmade/s3-uploads": "3.0.13",
    "wpackagist-plugin/elementor": "4.1.4",
    "wpackagist-plugin/timeline-widget-addon-for-elementor": "1.6.27",
    "wpackagist-plugin/bulk-post-update-date": "1.6.0",
    "themeforest/veapp": "1.0.0",
    "wpackagist-theme/hello-elementor": "3.4.9",
    "wpackagist-plugin/template-kit-import": "1.0.16",
    "wpackagist-plugin/header-footer-elementor": "2.9.1",
    "wpackagist-plugin/split-test-for-elementor": "1.9.1",
    "wpackagist-plugin/coming-soon": "6.20.4",
    "wpackagist-plugin/contact-form-7": "6.1.6",
    "wpackagist-plugin/wordpress-seo": "28.0",
    "wpackagist-plugin/classic-editor": "1.7.0",
    "wpackagist-plugin/wp-smushit": "3.24.0",
    "wpackagist-plugin/wp-2fa": "2.9.3",
    "wpackagist-plugin/disable-xml-rpc": "1.0.1",
    "wpackagist-plugin/headers-security-advanced-hsts-wp": "5.3.2",
    "wpackagist-plugin/seo-by-rank-math": "1.0.273",
    "wpackagist-plugin/wp-mail-smtp": "3.11.1",
    "wpackagist-plugin/gtranslate": "2.9.15",
    "wpackagist-plugin/cf7-invisible-recaptcha": "1.3.4",
    "wpackagist-plugin/translatepress-multilingual": "2.10.7",
    "wpackagist-plugin/forminator": "1.55.1",
    "wpackagist-plugin/wp-sweep": "1.1.9",
    "wpackagist-plugin/varnish-http-purge": "5.12.0",
    "wpackagist-plugin/safe-svg": "2.4.0",
    "koodimonni-language/fr_fr": "7.0.2",
    "koodimonni-language/core-fr_fr": "7.0.2",
    "hipdevteam/elementor-pro": "4.1.2",
    "axeptio/cookies": "1.0.0",
    "translatepress/business": "1.2.2",
    "wp-media/wp-rocket": "3.22.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.4.2",
    "roave/security-advisories": "dev-master"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "koodimonni/composer-dropin-installer": true,
      "roots/wordpress-core-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "dropin-paths": {
      "htdocs/wp-content/languages/": [
        "vendor:koodimonni-language"
      ],
      "htdocs/wp-content/languages/plugins/": [
        "vendor:koodimonni-plugin-language"
      ],
      "htdocs/wp-content/languages/themes/": [
        "vendor:koodimonni-theme-language"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\""
    ],
    "test": [
      "phpcs"
    ]
  }
}